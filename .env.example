# Copy to .env for local dev. Never commit .env.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Local: http://localhost:8080/auth/whoop/callback   Fly: https://<app>.fly.dev/auth/whoop/callback
WHOOP_REDIRECT_URI=http://localhost:8080/auth/whoop/callback
DASHBOARD_PASSWORD=
# python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SESSION_SECRET=
# Optional: enables the MCP endpoint at /mcp. Leave empty to disable it.
MCP_TOKEN=
DATA_DIR=./data
SYNC_HOUR=9
SYNC_MINUTE=0
TZ=Asia/Kolkata
INITIAL_DAYS=365
